# MongoDB Atlas Connection URI
# Replace <username>, <password>, and the cluster URL with your actual MongoDB Atlas credentials.
# Make sure to whitelist 0.0.0.0/0 in MongoDB Atlas -> Network Access!
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional: Custom database name (default: gdgoc_campaign)
MONGODB_DB=gdgoc_campaign

# Admin PIN for clearing leaderboard or managing roster
ADMIN_PIN=CITGDG2024

# Port for local server (default: 5000)
PORT=5000
